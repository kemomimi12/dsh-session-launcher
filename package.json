{
  "name": "dsh-session-launcher",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Create a new Harness session that inherits the caller's workspace, agent preset, and working directory, and seed it with an opening prompt, so a long task can continue in a fresh context window.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session",
    "context-window",
    "handoff",
    "agent-preset"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
